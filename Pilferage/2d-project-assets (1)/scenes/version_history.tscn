theme_override_font_sizes/font_size = 32
text = "- Fixed the version history, now you can actually
see the updates
- Updated the sidescroller level with more obstacles
to try out
- You can now return to the hubworld by moving off the
edge of the screen to the left
- The hub world also has a way to enter the sidescroller
level
- The cat is now in the hub world, press the shift key
to sprint
- The cat in the sidescroller now faces in a direction
based on its current velocity instead of the direction
of the most recent input"
horizontal_alignment = 1

